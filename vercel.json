{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "src": "^/details\\.html$", "dest": "/api/og" },
    { "src": "^/details$", "dest": "/api/og" },
    { "src": "^/product$", "dest": "/api/og" },
    { "src": "^/product/([^/]+)$", "dest": "/api/og?id=$1" },
    { "src": "^/showroom$", "dest": "/index.html" },
    { "handle": "filesystem" }
  ],
  "functions": {
    "api/og-image.js": {
      "includeFiles": "node_modules/ffmpeg-static/ffmpeg*"
    }
  }
}