# ═══════════════════════════════════════════════════════════════
# KCO Global Online Marketplace — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to ".env" and fill in your values.
# Variables prefixed with VITE_ are exposed to the browser (client-side).
# Variables without the VITE_ prefix are server-side only (edge functions).
# NEVER commit your real .env file to version control.
# ═══════════════════════════════════════════════════════════════

# ── SUPABASE (pre-configured — do not change) ──────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side Supabase keys (used by edge functions — already set in Supabase)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# SUPABASE_DB_URL=postgresql://...

# ── FLUTTERWAVE (payments) ─────────────────────────────────────
# Get these from https://dashboard.flutterwave.com/dashboard/settings/apis
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your-public-key-here
FLW_SECRET_KEY=FLWSECK_TEST-your-secret-key-here
FLW_ENCRYPTION_KEY=FLWSECK_TEST-your-encryption-key-here

# ── RESEND (transactional emails) ─────────────────────────────
# Get this from https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key-here

# ── SENDER EMAIL ADDRESSES ────────────────────────────────────
# Two professional sender addresses — the edge functions automatically
# select the correct one based on the email type.
#
# FROM_EMAIL_SYSTEM (noreply@) — used for:
#   Account verification, password reset, 2FA codes, login alerts,
#   security notifications, system notifications, AI-generated emails.
#
# FROM_EMAIL_SUPPORT (support@) — used for:
#   Order confirmations, payment confirmations, shipping & delivery
#   updates, customer support replies, contact form responses,
#   marketplace notifications, general customer communications.
#
# Backward compatible: if these are unset, the legacy FROM_EMAIL var
# is used as a fallback for both.
FROM_EMAIL_SYSTEM=KCO Global Online Marketplace <noreply@kcoglobalonlinemarket.com>
FROM_EMAIL_SUPPORT=KCO Global Online Marketplace <support@kcoglobalonlinemarket.com>

# ── GOOGLE ANALYTICS ───────────────────────────────────────────
# Measurement ID from https://analytics.google.com (format: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── FIREBASE CLOUD MESSAGING (push notifications) ──────────────
# Client-side config: Firebase Console → Project Settings → General → Your apps
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
# VAPID key from Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
VITE_FIREBASE_VAPID_KEY=YOUR_FIREBASE_VAPID_KEY

# Server-side config: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Download the JSON key file. Copy these three fields into the Supabase Edge Function secrets:
#   FIREBASE_PROJECT_ID  → "project_id" field
#   FIREBASE_CLIENT_EMAIL → "client_email" field
#   FIREBASE_PRIVATE_KEY → "private_key" field (keep the \n escape sequences as-is)
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=YOUR_FIREBASE_CLIENT_EMAIL
FIREBASE_PRIVATE_KEY=YOUR_FIREBASE_PRIVATE_KEY

# ── OPENAI (AI assistant) ──────────────────────────────────────
# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ═══════════════════════════════════════════════════════════════
# SOCIAL MEDIA PUBLISHING SYSTEM (Admin → Social Media Automation)
# ═══════════════════════════════════════════════════════════════
# Server-side Supabase credentials (used by Vercel API functions):
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Encryption key for social access/refresh tokens (AES-256-GCM).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SOCIAL_TOKEN_ENC_KEY=replace-with-a-long-random-string

# Secret used by the scheduler cron (Vercel Cron sends "Authorization:
# Bearer <value>"; set the SAME value in Vercel → Project Settings → Cron Jobs).
SCHEDULER_CRON_SECRET=replace-with-a-random-secret

# ── TikTok (official TikTok for Business / Developer Portal) ───
# Docs: https://developers.tiktok.com/app/  → create your app externally.
# NEVER put these in the browser. Add the callback as:
#   https://YOURSITE.com/api/social/oauth/callback?platform=tiktok
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
# Post privacy on TikTok: SELF_ONLY (unless app is approved for PUBLIC)
# TIKTOK_PRIVACY_LEVEL=SELF_ONLY   → see Platform Settings → TikTok

# ── Telegram (official Telegram Bot API) ───────────────────────
# From @BotFather. No OAuth; bot token + destination chat/channel id.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Optional default destination (or set it in Platform Settings → Telegram):
# TELEGRAM_CHAT_ID=@yourchannel

# ── Facebook Pages (Meta Graph API) ────────────────────────────
# https://developers.facebook.com/apps/  (may require review/verification)
FB_CLIENT_ID=your-facebook-app-id
FB_CLIENT_SECRET=your-facebook-app-secret

# ── Instagram (Meta Graph API — Instegram Business/Creator) ────
# May reuse the FB app. Requires linked IG business + review.
INSTAGRAM_CLIENT_ID=your-instagram-app-id
INSTAGRAM_CLIENT_SECRET=your-instagram-app-secret

# ── YouTube (Google Cloud + YouTube Data API v3) ───────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── X (Twitter API v2 / developer app) ─────────────────────────
X_CLIENT_ID=your-x-client-id
X_CLIENT_SECRET=your-x-client-secret

# ── Pinterest (API v5 developer app) ───────────────────────────
PINTEREST_CLIENT_ID=your-pinterest-app-id
PINTEREST_CLIENT_SECRET=your-pinterest-app-secret

# ── LinkedIn (OAuth app — w_member_social) ─────────────────────
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# ── WhatsApp Business Cloud API (Meta) ─────────────────────────
WHATSAPP_ACCESS_TOKEN=your-meta-system-user-token
# WHATSAPP_PHONE_ID=your-waba-phone-number-id
# WHATSAPP_RECIPIENT=15551234567
# WHATSAPP_CHANNEL_ID=your-whatsapp-channel-id

# ── VITE_SITE_URL (used to build OAuth redirect URIs) ──────────
VITE_SITE_URL=https://yourdomain.com
